# Variables de la pila de producción (docker-compose.yml).
# Cópialo con el nombre .env.production y rellénalo: ese fichero no se sube a GitHub.
#   cp .env.production.example .env.production

# Dominio de la web y de la API. Los dos tienen que apuntar (registro DNS tipo A) a la IP del servidor.
DOMAIN=spotter.ejemplo.com
API_DOMAIN=api.spotter.ejemplo.com

# Correo para Let's Encrypt (avisos si un certificado va a caducar)
ACME_EMAIL=tu-correo@ejemplo.com

# Secretos con los que se firman los tokens JWT: uno para el access token y otro para el refresh token.
# Tienen que ser distintos, largos y aleatorios. Se pueden generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiame-por-un-texto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambiame-por-otro-texto-largo-y-aleatorio

# Cuánto dura cada token (opcional): 15m son 15 minutos, 7d son 7 días.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
